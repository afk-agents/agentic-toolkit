# Convex Management API Token
# Get your token from: https://dashboard.convex.dev
# Token types:
#   - Team Access Token: Manage your team's projects
#   - OAuth Application Token: For integrations
CONVEX_TOKEN=your_token_here

# Convex Deployment URL
# Get your deployment URL from: https://dashboard.convex.dev
# Example: https://acoustic-panther-728.convex.cloud
CONVEX_URL=your_deployment_url_here

# Optional: JWT token for authenticated function calls
# Get from your auth provider (Clerk, Auth0, etc.)
CONVEX_AUTH_TOKEN=your_jwt_token_here
